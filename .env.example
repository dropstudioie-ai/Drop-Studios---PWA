# Public (browser) configuration. Only the Supabase *anon* key belongs here —
# never the service_role key or any Stripe secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "stripe" for real payments, "test" to use the dev-only checkout
# (also requires ALLOW_TEST_PAYMENTS=true on the edge function).
VITE_PAYMENTS_MODE=stripe

# Optional, for future web push notifications.
VITE_VAPID_PUBLIC_KEY=

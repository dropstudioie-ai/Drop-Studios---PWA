# Public (browser) configuration. Only the Supabase *anon* key belongs here —
# never the Supabase secret/service_role key or any Square access token.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "live" for real payments (Square), "test" to use the dev-only checkout
# (also requires ALLOW_TEST_PAYMENTS=true on the edge function).
VITE_PAYMENTS_MODE=live

# Optional, for future web push notifications.
VITE_VAPID_PUBLIC_KEY=

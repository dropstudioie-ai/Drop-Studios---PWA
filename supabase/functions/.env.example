# Edge function secrets. Locally: supabase functions serve --env-file supabase/functions/.env
# In production: supabase secrets set KEY=value   (never commit real values)
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Development only. Must be absent/false in production.
ALLOW_TEST_PAYMENTS=false

# Notifications (send-notifications). Configure email, push, or both.
CRON_SECRET=change-me
RESEND_API_KEY=
EMAIL_FROM="Drop Studios <hello@example.com>"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
